model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("D&D/05 - Wikipedia/Zauber")
        - file.fullname.endsWith(".md")
    order:
      - file.name
      - aliases
    sort:
      - property: file.name
        direction: ASC
