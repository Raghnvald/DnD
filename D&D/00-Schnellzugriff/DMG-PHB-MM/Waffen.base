filters:
  and:
    - '!file.name.containsAny("1", "2", "3")'
    - '!file.name.containsAny("-xdmg", "-xphb", "-xmm")'
    - '!file.name.containsAny("Antwort-a", "Antwort-b", "Antwort-e", "Antwort-k", "Antwort-l", "Antwort-s", "Antwort-u", "Antwort-w")'
    - '!file.name.containsAny("-Schlummernd-", "-Erhaben-", "-Erwacht-", "-Awakened-", "-Dormant-", "-Exalted-", "-Ahn-", "-Erwachend-", "-Erweckt-")'
formulas:
  Untitled: link(file, Bezeichnung)
properties:
  file.name:
    displayName: Name
  formula.Untitled:
    displayName: Name
  note.status:
    displayName: status
views:
  - type: table
    name: Waffen
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - file.tags.contains("Gegenstand/Waffe")
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - file.name
      - Kst.
      - Gew.
      - Eigenschaften
      - Status
    sort:
      - property: file.name
        direction: ASC
      - property: Status
        direction: ASC
    columnSize:
      note.Eigenschaften: 372
  - type: table
    name: Waffen 2
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - file.tags.contains("Gegenstand/Waffe")
        - Status == "WIP"
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - file.name
      - Kst.
      - Gew.
      - Eigenschaften
      - Status
    sort:
      - property: file.name
        direction: ASC
      - property: Status
        direction: ASC
    columnSize:
      note.Eigenschaften: 372
  - type: table
    name: Nahkampfwaffen
    filters:
      or:
        - Typ.contains("Einfache Nahkampfwaffe")
        - Typ.contains("Nahkampf-Kriegswaffe")
    groupBy:
      property: Typ
      direction: ASC
    order:
      - file.name
      - Kst.
      - Schaden
      - Gew.
      - Eigenschaften
    sort: []
    columnSize:
      note.Kst.: 92
      note.Schaden: 114
  - type: table
    name: Fernkampfwaffen
    filters:
      or:
        - Typ.contains("Einfache Fernkampfwaffe")
        - Typ.contains("Fernkampf-Kriegswaffe")
    groupBy:
      property: Typ
      direction: ASC
    order:
      - file.name
      - Kst.
      - Schaden
      - Schadensart
      - Gew.
      - Eigenschaften
    sort:
      - property: file.name
        direction: ASC
