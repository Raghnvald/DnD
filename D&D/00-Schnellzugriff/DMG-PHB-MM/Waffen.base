filters:
  and:
    - '!file.name.endsWith("-xphb")'
    - '!file.name.endsWith("-xdmg")'
    - '!file.name.endsWith("-egw")'
    - '!file.name.endsWith("-bmt")'
    - '!file.name.endsWith("-cm")'
    - and:
        - '!file.name.contains("1")'
        - '!file.name.contains("2")'
        - '!file.name.contains("3")'
    - and:
        - '!file.name.contains("der_Antwort-a")'
        - '!file.name.contains("der_Antwort-b")'
        - '!file.name.contains("der_Antwort-e")'
        - '!file.name.contains("der_Antwort-k")'
        - '!file.name.contains("der_Antwort-l")'
        - '!file.name.contains("der_Antwort-s")'
        - '!file.name.contains("der_Antwort-u")'
        - '!file.name.contains("der_Antwort-w")'
formulas:
  Untitled: link(file, Bezeichnung)
properties:
  file.name:
    displayName: Name
  formula.Untitled:
    displayName: Name
views:
  - type: table
    name: Waffen
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - file.tags.contains("Gegenstand/Waffe")
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - file.name
    sort:
      - property: formula.Untitled
        direction: ASC
    columnSize: {}
  - type: table
    name: Nahkampfwaffen
    filters:
      or:
        - Typ.contains("Einfache Nahkampfwaffe")
        - Typ.contains("Nahkampf-Kriegswaffe")
    groupBy:
      property: Typ
      direction: ASC
    order:
      - file.name
      - Kst.
      - Schaden
      - Gew.
      - Eigenschaften
    sort: []
    columnSize:
      note.Kst.: 92
      note.Schaden: 114
  - type: table
    name: Fernkampfwaffen
    filters:
      or:
        - Typ.contains("Einfache Fernkampfwaffe")
        - Typ.contains("Fernkampf-Kriegswaffe")
    groupBy:
      property: Typ
      direction: ASC
    order:
      - file.name
      - Kst.
      - Schaden
      - Schadensart
      - Gew.
      - Eigenschaften
    sort:
      - property: file.name
        direction: ASC
