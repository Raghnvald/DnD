filters:
  and:
    - '!file.name.endsWith("-xphb")'
formulas:
  Bezeichnung: link(file, Bezeichnung)
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Bardenzauber
    filters:
      and:
        - file.tags.contains("Klasse/Barde")
        - file.folder == "D&D/Zauber"
    groupBy:
      property: Zaubergrad
      direction: ASC
    order:
      - formula.Bezeichnung
      - Zeitaufwand
      - Reichweite
      - Komponenten
      - Wirkungsdauer
      - Angriff
      - Schaden
      - status
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 200
      note.Reichweite: 100
      note.Komponenten: 100
      note.Wirkungsdauer: 150
      note.Angriff: 75
      note.Schaden: 150
  - type: table
    name: Bardenzaubertricks
    filters:
      and:
        - file.tags.contains("Klasse/Barde")
        - file.tags.contains("Zauber/Grad/0")
