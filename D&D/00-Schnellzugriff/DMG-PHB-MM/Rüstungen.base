filters:
  and:
    - '!file.name.containsAny("1", "2", "3")'
    - '!file.name.containsAny("-xdmg", "-xphb", "-xmm")'
    - '!file.name.containsAny("-Blitz-", "-Energie-", "-Feuer-", "-Gift-", "-Gleißend-", "-Kälte-", "-Nekrotisch-", "-Psychisch-", "-Säure-", "-Schall-")'
    - '!file.name.containsAny("-Drachenschuppen-P", "_Drachenschuppen-P")'
    - '!file.name.containsAny("der_Verwundbarkeit-h", "der_Verwundbarkeit-s", "der_Verwundbarkeit-w")'
    - '!file.name.containsAny("-Schlummernd-", "-Erhaben-", "-Erwacht-", "-Awakened-", "-Dormant-", "-Exalted-")'
formulas:
  Untitled 2: link(file, Bezeichnung)
properties:
  file.name:
    displayName: Name
  formula.Untitled 2:
    displayName: Name
views:
  - type: table
    name: Rüstungen
    filters:
      or:
        - file.tags.contains("Gegenstand/Rüstung/Leicht")
        - file.tags.contains("Gegenstand/Rüstung/Mittel")
        - file.tags.contains("Gegenstand/Rüstung/Schwer")
        - file.tags.contains("Gegenstand/Rüstung/Schild")
    groupBy:
      property: Rüstung
      direction: ASC
    order:
      - formula.Untitled 2
      - Kst.
      - Gew.
      - RK
      - STR
      - Heiml.
      - Eigenschaften
      - Einstimmung
    sort:
      - property: formula.Untitled 2
        direction: ASC
      - property: RK
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      formula.Untitled 2: 313
      note.Kst.: 88
      note.RK: 138
    markers: bullet
    nestedProperties: false
