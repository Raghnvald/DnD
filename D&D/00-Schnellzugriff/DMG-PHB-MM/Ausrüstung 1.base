formulas:
  Untitled: link(file, Bezeichnung)
properties:
  file.basename:
    displayName: Name
  file.name:
    displayName: Name
  formula.Untitled:
    displayName: Bezeichnung
views:
  - type: table
    name: Ausrüstung
    filters:
      and:
        - file.tags.contains("Gegenstand/Seltenheit")
    order:
      - formula.Untitled
      - tags
      - Seltenheit
    sort:
      - property: Seltenheit
        direction: ASC
      - property: tags
        direction: ASC
      - property: formula.Untitled
        direction: ASC
      - property: Bezeichnung
        direction: ASC
    columnSize:
      formula.Untitled: 300
      note.tags: 1330
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Ausrüstung 2
    filters:
      and:
        - file.tags.contains("Gegenstand/Seltenheit")
    order:
      - formula.Untitled
      - Status
    sort:
      - property: Seltenheit
        direction: ASC
      - property: tags
        direction: ASC
      - property: formula.Untitled
        direction: ASC
      - property: Bezeichnung
        direction: ASC
    columnSize:
      formula.Untitled: 300
      note.tags: 1330
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Ausrüstung 2 2
    filters:
      and:
        - file.tags.contains("Gegenstand/Seltenheit")
        - file.tags.contains("Quelle/5e/dmg")
    order:
      - formula.Untitled
      - Quelle
      - Status
    sort:
      - property: formula.Untitled
        direction: ASC
    columnSize:
      formula.Untitled: 300
      note.tags: 1330
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Gifte
    filters:
      and:
        - file.tags.contains("Gegenstand/Ausrüstung/Gift")
    groupBy:
      property: Typ
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
    sort:
      - property: file.basename
        direction: ASC
    columnSize:
      note.Kst.: 83
      note.Gew.: 79
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Handelsgüter
    filters:
      and:
        - file.tags.contains("Gegenstand/Ausrüstung/Handelsgut")
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
      - status
    sort:
      - property: formula.Untitled
        direction: ASC
    columnSize:
      note.Kst.: 72
      note.Gew.: 79
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Reit- und Lasttiere
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - Kategorie == "Reit- und Lastentier"
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Bew.
      - Traglast
      - status
    sort:
      - property: formula.Untitled
        direction: ASC
  - type: table
    name: Ringe
    filters:
      and:
        - Kategorie == "Ring"
        - '!file.fullname.containsAny("des_Widerstands-B", "des_Widerstands-E", "des_Widerstands-F", "des_Widerstands-G", "des_Widerstands-K", "des_Widerstands-N", "des_Widerstands-P", "des_Widerstands-S")'
        - '!file.fullname.containsAny("-Herrschaft-dmg")'
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
      - status
  - type: table
    name: Rüstung
    filters:
      or:
        - and:
            - file.tags.containsAny("Gegenstand/Rüstung/Leicht", "Gegenstand/Rüstung/Mittel", "Gegenstand/Rüstung/Schwer", "Gegenstand/Rüstung/Schild")
            - '!file.fullname.containsAny("-Erwacht-", "-Erhaben-", "-dormant-", "-awakened-", "-exalted-", "-Schlummernd-")'
            - '!file.fullname.containsAny("des_Widerstands-B", "des_Widerstands-E", "des_Widerstands-F", "des_Widerstands-G", "des_Widerstands-K", "des_Widerstands-N", "des_Widerstands-P", "des_Widerstands-S")'
            - '!file.fullname.containsAny("-Hiebschaden-", "-Stichschaden-", "-Wuchtschaden-")'
            - '!file.fullname.containsAny("-Drachenschuppen-Panzer", "_Drachenschuppen-Panzer")'
    groupBy:
      property: Rüstung
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - RK
      - STR
      - Heiml.
      - Eigenschaften
      - Einstimmung
    columnSize:
      note.Kst.: 72
      note.Gew.: 79
      note.Eigenschaften: 281
  - type: table
    name: Schriftrollen
    filters:
      and:
        - Kategorie == "Schriftrolle"
        - '!file.fullname.contains("Schriftrolle_des_Schutzes_")'
    order:
      - file.name
      - Bezeichnung
    sort:
      - property: Bezeichnung
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Tränke
    filters:
      and:
        - Kategorie == "Trank"
        - '!file.fullname.contains("_Heilung-dmg.md")'
        - '!file.fullname.containsAny("des_Widerstands-B", "des_Widerstands-E", "des_Widerstands-F", "des_Widerstands-G", "des_Widerstands-K", "des_Widerstands-N", "des_Widerstands-P", "des_Widerstands-S")'
        - '!file.fullname.containsAny("der_Riesenstärke-F", "der_Riesenstärke-H", "der_Riesenstärke-S", "der_Riesenstärke-W")'
        - '!file.fullname.containsAny("der_Gedankenkontrolle-H", "der_Gedankenkontrolle-M", "der_Gedankenkontrolle-Ti")'
    order:
      - file.basename
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
      - status
  - type: table
    name: Waffen
    filters:
      and:
        - file.tags.contains("Gegenstand/Waffe")
        - and:
            - file.tags.contains("Gegenstand/Waffe")
            - '!file.fullname.containsAny("-Erwacht-", "-Erhaben-", "-dormant-", "-awakened-", "-exalted-", "-Schlummernd-")'
            - '!file.fullname.containsAny("-Ahn-", "-Erwachend-", "-Erweckt-")'
        - Status == "WIP"
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
  - type: table
    name: Wasserfahrzeuge
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - Kategorie == "Wasserfahrzeuge"
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Bew.
      - Traglast
    sort:
      - property: formula.Untitled
        direction: ASC
    columnSize:
      note.Kst.: 92
      note.Bew.: 93
