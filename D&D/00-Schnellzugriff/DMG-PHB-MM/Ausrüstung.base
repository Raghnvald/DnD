filters:
  and:
    - '!file.name.endsWith("-xphb")'
    - '!file.name.endsWith("-xdmg")'
    - '!file.name.endsWith("-egw")'
    - '!file.name.endsWith("-tdcsr")'
    - '!file.name.endsWith("-bmt")'
    - '!file.name.endsWith("-cm")'
    - and:
        - '!file.name.contains("0")'
        - '!file.name.contains("1")'
        - '!file.name.contains("2")'
        - '!file.name.contains("3")'
formulas:
  Untitled: link(file, Bezeichnung)
properties:
  file.basename:
    displayName: Name
  file.name:
    displayName: Name
  formula.Untitled:
    displayName: Name
views:
  - type: table
    name: Ausrüstung
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - file.tags.contains("Gegenstand/Ausrüstung")
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
    sort:
      - property: formula.Untitled
        direction: ASC
    columnSize: {}
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Gifte
    filters:
      and:
        - file.tags.contains("Gegenstand/Ausrüstung/Gift")
    groupBy:
      property: Typ
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
    sort:
      - property: file.basename
        direction: ASC
    columnSize:
      note.Kst.: 83
      note.Gew.: 79
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Handelsgüter
    filters:
      and:
        - file.tags.contains("Gegenstand/Ausrüstung/Handelsgut")
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Gew.
      - Eigenschaften
    sort:
      - property: formula.Untitled
        direction: ASC
    columnSize:
      note.Kst.: 72
      note.Gew.: 79
    markers: bullet
    nestedProperties: false
    imageFit: contain
  - type: table
    name: Reit- und Lasttiere
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - Kategorie == "Reit- und Lastentier"
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Bew.
      - Traglast
    sort:
      - property: formula.Untitled
        direction: ASC
  - type: table
    name: Rüstung
    filters:
      or:
        - file.tags.containsAny("Gegenstand/Rüstung/Leicht", "Gegenstand/Rüstung/Mittel", "Gegenstand/Rüstung/Schwer", "Gegenstand/Rüstung/Schild")
    groupBy:
      property: Rüstung
      direction: ASC
    order:
      - formula.Untitled
  - type: table
    name: Waffen
    filters:
      and:
        - file.tags.contains("Gegenstand/Waffe")
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
  - type: table
    name: Wasserfahrzeuge
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - Kategorie == "Wasserfahrzeuge"
    groupBy:
      property: Kategorie
      direction: ASC
    order:
      - formula.Untitled
      - Kst.
      - Bew.
      - Traglast
    sort:
      - property: formula.Untitled
        direction: ASC
    columnSize:
      note.Kst.: 92
      note.Bew.: 93
