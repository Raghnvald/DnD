model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Celestische MM
    filters:
      and:
        - file.folder == "D&D/Bestiarium/Celestisch"
        - file.ext == "md"
        - '!file.fullname.containsAny("-xmm.md", "-xphb.md")'
    cardSize: 120
    image: note.IMAGE
    imageFit: contain
  - type: cards
    name: Celestische XMM
    filters:
      and:
        - file.folder == "D&D/Bestiarium/Celestisch"
        - file.ext == "md"
        - '!file.fullname.contains("-mm")'
    cardSize: 120
    image: note.IMAGE
    imageFit: contain
