model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Aberrationen MM
    filters:
      and:
        - file.folder == "D&D/Bestiarium/Aberration"
        - file.ext == "md"
        - '!file.fullname.contains("-xmm.md")'
    order:
      - file.name
      - Kategorie
      - Größe
      - HG
      - Habitat
      - IMAGE
      - status
    image: note.IMAGE
    imageFit: contain
    cardSize: 120
  - type: table
    name: Aberrationen XMM
    filters:
      and:
        - file.folder == "D&D/Bestiarium/Aberration"
        - file.ext == "md"
        - '!file.fullname.contains("-mm.md")'
    order:
      - file.name
      - HG
    sort:
      - property: aliases
        direction: ASC
    image: note.Image
    imageFit: contain
    cardSize: 130
