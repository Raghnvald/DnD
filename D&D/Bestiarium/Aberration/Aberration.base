model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: cards
    name: Aberrationen
    filters:
      and:
        - file.folder == "D&D/Bestiarium/Aberration"
        - file.ext == "md"
    image: note.Image
    imageFit: contain
    cardSize: 130
  - type: table
    name: Aberrationen 2
    filters:
      and:
        - file.folder == "D&D/Bestiarium/Aberration"
        - file.ext == "md"
    order:
      - file.name
      - aliases
    sort:
      - property: aliases
        direction: ASC
    image: note.Image
    imageFit: contain
    cardSize: 130
