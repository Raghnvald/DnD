model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
formulas:
  Untitled: link(file, Bezeichnung)
properties:
  formula.Untitled:
    displayName: Name
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "D&D/Zauber"
        - '!file.fullname.contains("xphb")'
    order:
      - file.name
      - Bezeichnung
      - Status
    sort:
      - property: file.name
        direction: ASC
      - property: formula.Untitled
        direction: ASC
      - property: aliases
        direction: ASC
