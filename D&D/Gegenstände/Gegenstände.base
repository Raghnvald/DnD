model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
    order:
      - Bezeichnung
      - file.name
      - aliases
      - status
    sort:
      - property: file.name
        direction: ASC
