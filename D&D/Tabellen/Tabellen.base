model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "D&D/Tabellen"
    order:
      - file.name
      - aliases
    sort:
      - property: aliases
        direction: ASC
    columnSize:
      file.name: 564
