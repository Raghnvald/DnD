filters:
  and:
    - '!file.basename.containsAny("-xdmg", "-xphb", "-egw", "-ggr", "-bmt", "-idrotf", "-tdcsr", "-pabtso", "-cos", "-bgdia")'
views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("Gegenstand/Seltenheit/selten")
    order:
      - file.name
      - Bezeichnung
    markers: none
    indentProperties: true
  - type: table
    name: View
    filters:
      and:
        - Eigenschaften.contains("n/v")
    order:
      - file.name
      - Eigenschaften
