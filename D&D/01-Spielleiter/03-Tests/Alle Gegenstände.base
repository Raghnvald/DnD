model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - '!file.fullname.contains("xdmg")'
        - '!file.fullname.contains("xphb")'
    groupBy:
      property: Kategorie
      direction: ASC
  - type: table
    name: View2
    filters:
      and:
        - file.folder == "D&D/Gegenstände"
        - Kategorie == "Wundersamer Gegenstand"
        - '!file.tags.containsAny("Gegenstand/wundersam")'
