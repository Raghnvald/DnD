views:
  - type: table
    name: Klerikerzauber
    filters:
      and:
        - file.tags.contains("Klasse/Kleriker")
        - file.folder == "D&D/Zauber"
    groupBy:
      property: Zaubergrad
      direction: ASC
    order:
      - file.name
      - Zeitaufwand
      - Reichweite
      - Komponenten
      - Wirkungsdauer
      - Angriff
      - Schaden
      - status
    sort:
      - property: Bezeichnung
        direction: ASC
    columnSize:
      file.name: 200
      note.Reichweite: 100
      note.Komponenten: 100
      note.Wirkungsdauer: 150
      note.Angriff: 75
      note.Schaden: 150
